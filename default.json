{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base",
        "group:allNonMajor",
        ":semanticCommits",
        ":combinePatchMinorReleases",
        ":prHourlyLimit1",
        ":disableDependencyDashboard"
    ],
    "schedule": [
        "* * * * 0,6"
    ],
    "prConcurrentLimit": 5,
    "packageRules": [
        {
            "matchDepTypes": [
                "devDependencies"
            ],
            "prPriority": -1
        }
    ]
}